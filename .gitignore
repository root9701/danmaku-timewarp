# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.venv/
venv/
env/
.nox/

# ---------- 采集产物 ----------
# 目录结构见 SCHEMA.md:
#   data/{赛事日}/{room}/manifest.json + 切片 + afp + meta
#   data/_test/{日期}T{HHMM}_{room}/  测试会话
#
# 默认忽略 data 下全部内容，再逐条放行需要入库的会话。
# 目前只保留 2026-10-26 的正赛(20 万条, 用来验证回放链路)。
danmaku-collector/data/**
!danmaku-collector/data/.gitkeep
!danmaku-collector/data/2026-10-26/
!danmaku-collector/data/2026-10-26/7734200/

# ★ 音频指纹**必须入库**: 直播流已消失, 无法重新生成; 丢了就永远无法自动校准。
#   体积约 0.59MB/小时(一晚约 7MB), 换来的是一整晚的自动对齐能力。
!danmaku-collector/data/2026-10-26/7734200/*.afp.jsonl
!danmaku-collector/data/2026-10-26/7734200/*.afp.jsonl.gz
# 弹幕切片与索引
!danmaku-collector/data/2026-10-26/7734200/*.jsonl.gz
!danmaku-collector/data/2026-10-26/7734200/*.jsonl
!danmaku-collector/data/2026-10-26/7734200/*.meta.json
!danmaku-collector/data/2026-10-26/7734200/manifest.json

# 日志/锁/临时数据
danmaku-collector/logs/
danmaku-collector/logs_schedule_test/
danmaku-collector/data_phone/
danmaku-collector/data_schedule_test/
*.log
*.lock

# ---------- 运行时临时文件 ----------
run/
**/run/
tmp/
*.tmp
*.bak
*.orig
*.rej
*.npz

# ---------- 运行状态 ----------
# matches.json 记录具体回放的 BV 与 offset(含逐分P 对齐结果), 属于本机运行状态;
# 首次运行/重新对齐会自动重建。需要复现某次对齐结果时再单独备份。
danmaku-server/matches.json

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---------- 本地配置 ----------
# config.json 含本机房间号/端口/赛事选择, 不同机器不同值 -> 不入库。
# *.example.json 是模板, 必须入库(新用户照抄即可)。
danmaku-collector/config.json
danmaku-server/config.json



