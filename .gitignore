# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.venv/
venv/
env/
.nox/

# ---------- 采集产物 ----------
# 目录结构见 SCHEMA.md:
#   data/{赛事日}/{room}/manifest.json + 切片 + afp + meta
#   data/_test/{日期}T{HHMM}_{room}/  测试会话
#
# 数据放在**仓库根**的 data/(采集端代码与产物分家: 采集端可单独拷到手机跑,
# 它自己的默认 data_dir 仍相对脚本目录; 本机采集靠 config.json 写 ../data 指过来)。
#
# 默认忽略 data 下全部内容，再按**目录形状**放行正式会话。
#
# 为什么用通配而不是逐条列日期:
#   原来每新增一晚要手写 6 行放行规则, 忘写就会让那一晚**静默不入库** —— 数据在
#   本机好好的, git 里却没有, 等到换机器/分发时才发现, 而 afp 已无法重采。
#   改成形状匹配后, 新建的 data/{日期}/{房间}/ 自动纳入版本控制, 不需要改本文件。
#
# 仍然被挡住的是: data/_test/**(测试会话, 名字以 _ 开头) 与隐藏目录。
#
# 注意下面的放行规则用了 [!_]* 而不是 *: 只放行"不以 _ 开头"的目录。
# 若写成 data/*/, 规则意图就变成"放行 _test 目录", 只是碰巧被 data/** 先挡住了 ——
# 依赖规则先后顺序才正确, 以后调顺序就会把测试数据混进版本库。
data/**
!data/.gitkeep
!data/[!_]*/
!data/[!_]*/[!_]*/

# ★ 音频指纹**必须入库**: 直播流已消失, 无法重新生成; 丢了就永远不能自动校准。
#   当前 hop=0.4 约 3.5MB/小时(一晚约 13MB 前是 7MB); 旧数据 hop=0.2 约 7MB/晚。
!data/[!_]*/[!_]*/*.afp.jsonl
!data/[!_]*/[!_]*/*.afp.jsonl.gz
# 弹幕切片与索引
!data/[!_]*/[!_]*/*.jsonl.gz
!data/[!_]*/[!_]*/*.jsonl
!data/[!_]*/[!_]*/*.meta.json
!data/[!_]*/[!_]*/manifest.json

# 日志/锁/临时数据
danmaku-collector/logs/
danmaku-collector/logs_schedule_test/
danmaku-collector/data_phone/
danmaku-collector/data_schedule_test/
*.log
*.lock

# ---------- 运行时临时文件 ----------
run/
**/run/
tmp/
*.tmp
*.bak
*.orig
*.rej
*.npz

# ---------- 运行状态 ----------
# matches.json = **本地覆盖层**: 只装用户自己手动微调/新算的记录, 不入库。
# 上游分发的对齐结果在 danmaku-server/align/*.json(入库, 见 align/README.md)。
# 拆开的原因: 一个文件既装"作者算的"又装"用户改的", 既发不出去也合不回来。
danmaku-server/matches.json
danmaku-server/*.json.bak

# align/ 必须入库 —— 它是让别人「clone 下来就能回放」的核心资产
!danmaku-server/align/
!danmaku-server/align/*.json

# ---------- 打包产物 ----------
# tools/pack_data.py --strip-afp 生成的发行副本, 是"可重新生成"的中间产物
dist/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---------- 本地配置 ----------
# config.json 含本机房间号/端口/赛事选择, 不同机器不同值 -> 不入库。
# *.example.json 是模板, 必须入库(新用户照抄即可)。
danmaku-collector/config.json
danmaku-server/config.json



